# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.npm-cache 

# build artifacts
/out_prev_tmp/
/.next_old_tmp/

# local workbuddy memory
/.workbuddy/

# stale build dirs
/docs_stale_*/
/out_bak*/
/.next_bak*/
/out_prev*/
/.next_old*/
/.next_[0-9a-f]*/
/out_[0-9a-f]*/

# test fixtures (binary test media)
/test-fixtures/

# push debug logs
/push*.log
/build.log
/out_stale*/

# 构建期生成的翻译产物（由 CI 在 deploy 前跑 scripts/translate-content.mjs 重新生成）
/src/i18n/messages/*.json
/src/i18n/messages/index.ts
/src/i18n/content/*.json
/src/i18n/content/index.ts
/src/i18n/posts/*.json
/src/i18n/posts/index.ts

# 翻译缓存
/.cache/
