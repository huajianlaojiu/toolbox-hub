# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.npm-cache 

# build artifacts
/out_prev_tmp/
/.next_old_tmp/

# local workbuddy memory
/.workbuddy/

# stale build dirs
/docs_stale_*/
/out_bak*/
/.next_bak*/
/out_prev*/
/.next_old*/
/.next_[0-9a-f]*/
/out_[0-9a-f]*/

# test fixtures (binary test media)
/test-fixtures/

# push debug logs
/push*.log
/build.log
/translate-run.log
/tr-*.log
/shot-*.png
/out_stale*/

# 构建产物停放区（删除被安全策略拦截时临时 mv 出来，非交付物）
/.next.stale/
/out.old.stale/

# 翻译产物（15 语言静态 JSON + index.ts）已提交进仓库，作为无密钥时的译文来源；
# 配置 GOOGLE_TRANSLATE_KEY 后 CI 会重新生成，可在 PR 里 diff 校对。

# 翻译缓存
/.cache/

# 构建产物停放目录（safe-delete 拦截器挡删除时用 mv 让位，不影响仓库）
/.next.stale*/
/out.stale*/
/out.old*/
/out_bak*/
